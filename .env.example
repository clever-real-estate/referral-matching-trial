# Copy to .env to override defaults. Every value below is already the default.

# Postgres (docker-compose maps container 5432 -> host POSTGRES_PORT)
POSTGRES_PORT=5433
DB_NAME=referral_trial
DB_USER=referral
DB_PASSWORD=referral
DB_HOST=127.0.0.1
DB_PORT=5433

# Django
DJANGO_SECRET_KEY=dev-only-not-a-secret
DJANGO_DEBUG=1

# Shared secret the upstream intake system sends on webhook deliveries
WEBHOOK_TOKEN=dev-webhook-secret

# Frontend
VITE_API_BASE=http://127.0.0.1:8000
